<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_appointment_calendar" model="ir.ui.view">
        <field name="name">salon.appointment.calendar</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Jadwal Lapangan" 
                      date_start="datetime_start" 
                      date_stop="datetime_end" 
                      color="services" 
                      mode="week" 
                      quick_create="False" 
                      event_open_popup="True">
                <field name="customer" avatar_field="avatar_128"/>
                <field name="services"/>
            </calendar>
        </field>
    </record>
</odoo>