<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_create_appointment_tree" model="ir.ui.view">
        <field name="name">salon.appointment.tree</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="app_id"/>
                <field name="appointment_time" widget="float_time"/>

                <field name="services"/>
                <field name="customer"/>
                <field name="date"/>
                <field name="employee"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <record id="view_create_appointment_form" model="ir.ui.view">
        <field name="name">salon.appointment.form</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <button id="button_confirm" name="action_confirm" string="Confirm" class="btn-primary"
                            confirm="Are you sure that you need to confirm?"
                            type="object"
                            invisible="state != 'draft'"/>

                    <button id="button_done" name="action_done" string="Mark As Done" class="btn-primary"
                            type="object"
                            invisible="state != 'confirm'"/>

                    <button id="button_draft" name="action_draft" string="Set To Draft" class="btn-primary"
                            type="object"
                            invisible="state != 'cancel'"/>

                    <button id="button_cancel" name="action_cancel" string="Cancel"
                            confirm="Are you sure that you need to cancel?"
                            type="object"
                            invisible="state not in ('draft', 'done', 'confirm')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,confirm"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="app_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer" options="{'no_open': True}"/>
                            <field name="contact"/>
                            <field name="appointment_time" widget="float_time"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="services" string="Pilihan Lapangan" options="{'no_open': True, 'no_create': True}"/>
                            <field name="employee" options="{'no_open': True}"/>
                            <field name="date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_appointment_search_filters" model="ir.ui.view">
        <field name="name">salon.appointment.search</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <search string="Appointments">

                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirm" domain="[('state', '=', 'confirm')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Canceled" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <group expand="1" string="Group By">
                    <filter string="Services" name="services" context="{'group_by':'services'}"/>
                    <filter string="Customer" name="customer" context="{'group_by':'customer'}"/>
                    <filter string="Employee" name="employee" context="{'group_by':'employee'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_create_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Your First Appointment...!
            </p>
        </field>
    </record>


    <menuitem id="menu_appointment_root"
              name="Create Appointment"
              sequence="1"/>

    <menuitem id="menu_create_root"
              name="Appointments"
              parent="menu_appointment_root"
              action="action_create_appointment"
              sequence="10"/>


</odoo>